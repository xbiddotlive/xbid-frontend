{
  "name": "@xbid/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-public-chain-config.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:i18n && pnpm check:ui && pnpm check:architecture && node --test scripts/validate-public-chain-config.test.mjs scripts/base-sepolia-runtime.test.mjs scripts/arc-gas-budget.test.mjs scripts/discovery-tokens.test.mjs scripts/contest-scope.test.mjs scripts/stocks.test.mjs",
    "x:preview": "node scripts/publish-x-post.mjs --content content/x-posts/launch.json",
    "x:publish": "node --use-env-proxy --env-file=.env.x.local scripts/publish-x-post.mjs --content content/x-posts/launch.json --publish"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.102.8",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "twitter-text": "^3.1.0",
    "viem": "2.56.2",
    "wagmi": "2.19.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "decode-uri-component": "0.5.0",
      "qr": "0.6.0",
      "uuid": "11.1.1",
      "ws": "8.21.0"
    },
    "patchedDependencies": {
      "cuer@0.0.3": "patches/cuer@0.0.3.patch"
    }
  }
}
