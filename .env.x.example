# X API user-context credentials. Copy this file to .env.x.local and keep it local.
# The X developer App must have Read and Write permission.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional when api.x.com is only reachable through a local system proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
